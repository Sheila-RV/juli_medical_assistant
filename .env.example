# Copia este archivo a .env.local y rellena los valores.
# Sin claves la app funciona igual en MODO DEMO (respuestas de ejemplo, sin costo).

# --- OpenAI: una sola clave para transcribir y estructurar ---------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modelo que rellena la plantilla (p. ej. gpt-5.5, o gpt-5.4-mini para abaratar)
OPENAI_MODEL=gpt-5.5
# Esfuerzo de razonamiento: minimal | low | medium | high
OPENAI_REASONING_EFFORT=low

# --- Transcripción (endpoint compatible con /audio/transcriptions) ------------
# Por defecto usa OpenAI con la misma OPENAI_API_KEY.
# whisper-1 (Whisper, por defecto) · gpt-4o-transcribe (más preciso) · gpt-4o-mini-transcribe (más barato)
STT_MODEL=whisper-1
STT_LANGUAGE=es
# Opcional: otro proveedor, p. ej. Groq Whisper (capa gratuita)
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3-turbo
# STT_API_KEY=gsk_...

# --- Inicio de sesión -----------------------------------------------------------
# Firma las cookies de sesión. En producción pon un valor largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Opcional: reemplaza las cuentas de demo (y deja de mostrarlas en el login). JSON en una línea:
# AUTH_USERS=[{"id":"dra-ruiz","email":"dra.ruiz@clinica.mx","password":"...","name":"Dra. Ruiz","specialty":"Pediatría"}]

# --- Protección de la instancia pública ---------------------------------------
# Si se define, solo quien introduzca este código usa las APIs reales; el resto ve la demo.
ACCESS_CODE=
# true = fuerza el modo demo aunque haya claves
DEMO_MODE=false
# Peticiones por minuto y por IP para cada endpoint
RATE_LIMIT_PER_MINUTE=10
